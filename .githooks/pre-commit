#!/usr/bin/env bash
# Regenerates requirements.txt from uv.lock whenever pyproject.toml or uv.lock
# are part of the commit, so Vercel's pip-based build never sees a stale file.
set -euo pipefail

if git diff --cached --name-only | grep -qE '^(pyproject\.toml|uv\.lock)$'; then
    if ! command -v uv >/dev/null 2>&1; then
        echo "pre-commit: uv is not installed, skipping requirements.txt sync" >&2
        echo "pre-commit: install it from https://docs.astral.sh/uv/ and re-commit" >&2
        exit 1
    fi

    uv export --no-hashes --no-dev -o requirements.txt
    git add requirements.txt
fi
